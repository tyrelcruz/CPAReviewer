{
  "name": "backend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -b",
    "start": "node dist/index.js",
    "db:up": "docker compose -f ../docker-compose.yml up -d mysql phpmyadmin",
    "db:down": "docker compose -f ../docker-compose.yml down",
    "docker:dev": "docker compose -f ../docker-compose.yml up -d --build backend",
    "docker:dev:logs": "docker compose -f ../docker-compose.yml logs -f backend",
    "docker:dev:down": "docker compose -f ../docker-compose.yml stop backend",
    "db:seed": "tsx src/scripts/seed.ts",
    "db:migrate": "tsx src/scripts/migrate.ts",
    "db:ingest": "tsx src/scripts/ingestBank.ts"
  },
  "dependencies": {
    "@emailjs/nodejs": "^5.0.2",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "jsonwebtoken": "^9.0.3",
    "mysql2": "^3.11.4",
    "ua-parser-js": "^2.0.10"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^24.13.3",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
