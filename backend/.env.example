PORT=8001
DB_HOST=localhost
DB_PORT=3307
DB_USER=cpa_reviewer
DB_PASSWORD=cpa_reviewer
DB_NAME=cpa_reviewer
JWT_SECRET=change-me-in-production

# Optional — leave unset in local dev and OTP codes are logged to the
# backend console instead of emailed (see src/lib/mailer.ts). All four are
# from your EmailJS account; EMAILJS_PRIVATE_KEY additionally requires
# "Allow EmailJS API for non-browser applications" enabled under
# Account > Security, or server-side sends get rejected.
EMAILJS_SERVICE_ID=
EMAILJS_TEMPLATE_ID=
EMAILJS_PUBLIC_KEY=
EMAILJS_PRIVATE_KEY=
