PORT=8001
DB_HOST=localhost
DB_PORT=3307
DB_USER=cpa_reviewer
DB_PASSWORD=cpa_reviewer
DB_NAME=cpa_reviewer
JWT_SECRET=change-me-in-production

# Optional — leave unset in local dev and OTP codes are logged to the
# backend console instead of emailed (see src/lib/mailer.ts). All four are
# from your EmailJS account; EMAILJS_PRIVATE_KEY additionally requires
# "Allow EmailJS API for non-browser applications" enabled under
# Account > Security, or server-side sends get rejected.
EMAILJS_SERVICE_ID=
EMAILJS_TEMPLATE_ID=
EMAILJS_PUBLIC_KEY=
EMAILJS_PRIVATE_KEY=

# Optional, comma-separated — dev convenience only. Emails listed here skip
# real OTP delivery and verification entirely on /login (any code, e.g.
# 000000, is accepted), so testing as these accounts doesn't burn EmailJS
# send quota. Leave unset by default; NEVER set this in a production .env.
OTP_BYPASS_EMAILS=

# Optional — only needed to browse the Aiven production DB from the local
# phpMyAdmin container (see docker-compose.yml's phpmyadmin service and
# config.user.inc.php.example). Deliberately separate from DB_HOST/DB_PORT/
# DB_SSL_CA_PATH above so switching those between local/cloud for the backend
# itself never breaks this — phpMyAdmin still asks for username/password each
# time regardless, this only pre-fills host/port and SSL.
AIVEN_DB_HOST=
AIVEN_DB_PORT=
AIVEN_DB_SSL_CA_PATH=
