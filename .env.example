# Read by docker-compose.yml's ${VAR} substitution for the `backend` and
# `phpmyadmin` services when running `npm run docker:up`. Copy to `.env` and
# fill in real values — this file only documents what's expected.
JWT_SECRET=
EMAILJS_SERVICE_ID=
EMAILJS_TEMPLATE_ID=
EMAILJS_PUBLIC_KEY=
EMAILJS_PRIVATE_KEY=
OTP_BYPASS_EMAILS=

# Only needed if phpMyAdmin should also offer the Aiven production DB as a
# server choice; leave blank for local-only dev.
AIVEN_DB_HOST=
AIVEN_DB_PORT=
AIVEN_DB_SSL_CA_PATH=
